# Copy to .env.local and fill in. Never commit .env.local.
# Restart `npm run dev` after changing keys: mock/real is decided at startup.

# --- AI (Gemini): conversation, strategy, transcription, voice ---
GEMINI_API_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "MCG <strategy@mail.mcg.com.kw>"
EMAIL_FROM=
# Optional reply-to address for the strategy email
EMAIL_REPLY_TO=
# Where npm run test:email / test:api send their test emails
EMAIL_TEST_TO=
# Public URL the email loads the logo/icons from (Vercel sets VERCEL_PROJECT_PRODUCTION_URL automatically)
APP_URL=

# --- Leads (Postgres via Vercel's Neon integration) ---
# Set by the Neon integration on Vercel; `vercel env pull .env.local` copies it locally.
DATABASE_URL=
# "false" turns lead storage off even when DATABASE_URL is set
LEADS_ENABLED=

# --- Mocks ---
# true = offline mocks for every service. Unset = AI mocked while GEMINI_API_KEY is missing,
# email + leads mocked while RESEND_API_KEY or EMAIL_FROM is missing.
USE_MOCKS=

# --- Optional overrides (defaults in lib/config.ts) ---
GEMINI_CONVERSATION_MODEL=
GEMINI_TRANSCRIPTION_MODEL=
GEMINI_STRATEGY_MODEL=
GEMINI_TTS_MODEL=
# Prebuilt voice (e.g. Kore) or a Gulf Arabic voice id from `npm run voices`
GEMINI_TTS_VOICE=

# --- Admin (/admin) ---
# Shared password for the admin page (leads + stats). Changing it signs every admin out.
ADMIN_PASSWORD=
